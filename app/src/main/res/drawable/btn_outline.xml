<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/stroke" /><corners android:radius="24dp" /><stroke android:width="1.5dp" android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="24dp" /><stroke android:width="1.5dp" android:color="@color/accent" /></shape>
    </item>
</selector>
